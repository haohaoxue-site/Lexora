{
  "name": "@haohaoxue/lexora",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.5.0"
  },
  "scripts": {
    "predev": "pnpm dev:env",
    "dev": "pnpm -r --parallel --filter '!@lexora/buddy' --filter '!@haohaoxue/lexora-website' --if-present dev",
    "dev:env": "node infrastructure/scripts/sync-dev-env.mjs",
    "dev:infra": "docker compose --env-file infrastructure/.env -f infrastructure/compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f infrastructure/compose.dev.yml down",
    "predev:db:sync": "pnpm dev:env",
    "dev:db:sync": "pnpm --filter @haohaoxue/lexora-api prisma:sync",
    "predev:db:reset": "pnpm dev:env",
    "dev:db:reset": "pnpm --filter @haohaoxue/lexora-api exec prisma db push --force-reset",
    "predev:api": "pnpm dev:env",
    "dev:web": "pnpm --filter @haohaoxue/lexora-web dev",
    "dev:api": "pnpm --filter @haohaoxue/lexora-api dev",
    "predev:agent": "pnpm dev:env",
    "dev:agent": "pnpm --filter @haohaoxue/lexora-agent dev",
    "dev:buddy": "pnpm --filter @lexora/buddy dev",
    "dev:website": "pnpm --filter @haohaoxue/lexora-website dev",
    "build": "pnpm -r --if-present build",
    "build:website": "pnpm --filter @haohaoxue/lexora-website build",
    "preview:website": "pnpm --filter @haohaoxue/lexora-website preview",
    "package:buddy:deb": "RUST_MIN_STACK=16777216 pnpm --filter @lexora/buddy package:deb",
    "build:buddy:pet": "RUST_MIN_STACK=16777216 pnpm --filter @lexora/buddy package:pet",
    "release:version:check": "node packaging/release/version.mjs --check",
    "release:version:set": "node packaging/release/version.mjs --set",
    "release:status": "node packaging/release/status.mjs",
    "check:buddy": "node packaging/buddy/release/preflight.mjs",
    "check:website": "node packaging/website/release/verify-pages-workflow.mjs && pnpm --filter @haohaoxue/lexora-website lint && pnpm --filter @haohaoxue/lexora-website build",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "lint": "eslint apps packages",
    "lint:fix": "pnpm -r lint:fix",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "eslint": "^10.2.1",
    "typescript": "catalog:",
    "vitest": "^4.1.5"
  }
}
