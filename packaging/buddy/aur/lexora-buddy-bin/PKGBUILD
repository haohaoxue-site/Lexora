# Maintainer: Lexora maintainers

pkgname=lexora-buddy-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Lexora Buddy local personal AI companion and native desktop pet"
arch=('x86_64')
url="https://github.com/haohaoxue-site/Lexora"
license=('AGPL-3.0-only')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'bubblewrap'
  'cairo'
  'dbus'
  'desktop-file-utils'
  'expat'
  'gcc-libs'
  'glib2'
  'glibc'
  'git'
  'gtk-layer-shell'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libnotify'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'libxtst'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'util-linux-libs'
  'xdg-utils'
)
provides=('lexora-buddy')
conflicts=('lexora-buddy')
options=('!strip' '!debug')
_deb_name="Lexora-Buddy-${pkgver}-linux-amd64.deb"
_deb_url="${LEXORA_BUDDY_DEB_URL:-${url}/releases/download/v${pkgver}/${_deb_name}}"
_deb_sha256="${LEXORA_BUDDY_DEB_SHA256:-d849e41906c830bb851d4f5d05f8159d70f1d055c343dc90fad0ab32a22f9822}"
source_x86_64=("lexora-buddy-${pkgver}-amd64.deb::${_deb_url}")
sha256sums_x86_64=("${_deb_sha256}")

package() {
  local data_archive

  bsdtar --no-same-owner -xf "${srcdir}/lexora-buddy-${pkgver}-amd64.deb" -C "${srcdir}"
  data_archive="$(find "${srcdir}" -maxdepth 1 -name 'data.tar.*' -print -quit)"
  test -n "${data_archive}"
  bsdtar --no-same-owner -xf "${data_archive}" -C "${pkgdir}"
}
