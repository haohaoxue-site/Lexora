{
  "name": "@lexora/buddy",
  "productName": "Lexora Buddy",
  "type": "module",
  "version": "0.2.2",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "description": "Lexora Buddy local personal AI companion",
  "desktopName": "site.haohaoxue.LexoraBuddy",
  "author": {
    "name": "shanyuhai123",
    "email": "864299347@qq.com"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/haohaoxue-site/Lexora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haohaoxue-site/Lexora.git",
    "directory": "apps/buddy"
  },
  "bugs": {
    "url": "https://github.com/haohaoxue-site/Lexora/issues"
  },
  "main": "./.output/build/electron/main/index.js",
  "scripts": {
    "predev": "pnpm build:native-pet",
    "dev": "electron-vite dev",
    "build": "pnpm build:electron",
    "build:electron": "pnpm build:native-pet:release && vue-tsc -b --pretty false && electron-vite build",
    "build:native-pet": "cargo build --locked --target-dir .output/build/native-pet --manifest-path native-pet/Cargo.toml",
    "build:native-pet:release": "cargo build --locked --release --target-dir .output/build/native-pet --manifest-path native-pet/Cargo.toml",
    "clean": "node ../../packaging/buddy/release/clean-output.mjs",
    "package:arch": "pnpm build:electron && node ../../packaging/buddy/release/verify-electron-bundle.mjs && node ../../packaging/buddy/release/package-desktop.mjs --target pacman && node ../../packaging/buddy/release/verify-pacman-package.mjs",
    "package:deb": "pnpm build:electron && node ../../packaging/buddy/release/verify-electron-bundle.mjs && node ../../packaging/buddy/release/package-desktop.mjs --target deb && node ../../packaging/buddy/release/verify-deb-package.mjs",
    "package:pet": "pnpm build:native-pet:release && node ../../packaging/buddy/release/package-pet.mjs",
    "lint:fix": "eslint . --fix",
    "type-check": "vue-tsc -b --pretty false",
    "test": "vitest run --exclude electron/main/runtime/__tests__/buddyServiceProcess.integration.spec.ts --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@tiptap/vue-3": "^3.22.3",
    "@vicons/fluent": "^0.13.0",
    "@vueuse/core": "^14.3.0",
    "dayjs": "^1.11.21",
    "diff": "^8.0.4",
    "dompurify": "^3.4.14",
    "marked": "^18.0.5",
    "markstream-vue": "^2.0.6",
    "monaco-editor": "^0.56.0",
    "naive-ui": "^2.44.1",
    "smol-toml": "^1.7.1",
    "typebox": "^1.3.13",
    "vue": "^3.5.33",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sass-embedded": "^1.103.1",
    "typescript": "catalog:",
    "unocss": "^66.6.8",
    "vite": "^8.2.2",
    "vue-tsc": "^3.2.7"
  }
}
